{
	"name": "astro-cactus-blog",
	"version": "6.5.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"prebuild": "pnpm exec playwright install chromium",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"test": "vitest run --run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:html": "vitest run --reporter=html",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:urls": "node scripts/test-urls.js",
		"test:quick": "vitest run --reporter=verbose"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^6.3.2",
		"@astrojs/mdx": "4.3.0",
		"@astrojs/rss": "4.0.11",
		"@astrojs/sitemap": "3.4.0",
		"@tailwindcss/vite": "4.1.8",
		"astro": "5.8.1",
		"astro-expressive-code": "^0.41.2",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^7.0.7",
		"hastscript": "^9.0.0",
		"katex": "^0.16.22",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"playwright": "^1.52.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-mermaid": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "0.13.1",
		"satori-html": "^0.3.2",
		"sharp": "^0.34.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@biomejs/biome": "^1.9.4",
		"@iconify-json/mdi": "^1.2.2",
		"@pagefind/default-ui": "^1.3.0",
		"@playwright/test": "^1.55.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.16",
		"@types/hast": "^3.0.4",
		"@types/katex": "^0.16.7",
		"@types/mdast": "^4.0.4",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"happy-dom": "^18.0.1",
		"pagefind": "^1.3.0",
		"prettier": "^3.4.2",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"reading-time": "^1.5.0",
		"tailwindcss": "4.1.8",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.34.2"
		},
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
