---
import { Icon } from "astro-icon/components";

export interface Props {
	/** Size of the social icons (Tailwind classes) */
	iconSize?: string;
}

const { iconSize = "h-8 w-8" } = Astro.props;

/** 
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Only installed pack is: @iconify-json/mdi
*/
const socialLinks: {
	friendlyName: string;
	isWebmention?: boolean;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "Bluesky",
		link: "https://bsky.app/profile/andrewmarder.net",
		name: "bluesky",
	},
	{
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/andrew-marder/",
		name: "mdi:linkedin",
	},
	{
		friendlyName: "GitHub",
		link: "https://github.com/amarder",
		name: "mdi:github",
	},
	{
		friendlyName: "Email",
		link: "mailto:andrew@andrewmarder.net",
		name: "mdi:email",
	},
	{
		friendlyName: "RSS",
		link: "http://andrewmarder.net/rss.xml",
		name: "mdi:rss",
	},
];
---

<div class="flex flex-wrap items-end gap-x-2">
	<ul class="flex flex-1 items-center gap-x-2 sm:flex-initial">
		{
			socialLinks.map(({ friendlyName, isWebmention, link, name }) => (
				<li class="flex">
					<a
						class="hover:text-link inline-block"
						href={link}
						rel={`noreferrer ${isWebmention ? "me authn" : ""}`}
						target="_blank"
					>
						<Icon aria-hidden="true" class={iconSize} focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
