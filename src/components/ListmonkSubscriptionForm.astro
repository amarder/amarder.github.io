---
import { keilaFormUrl } from "@/site.config";

interface Props {
	formUrl?: string;
}

const {
	formUrl = keilaFormUrl,
} = Astro.props;
---

<div class="keila-subscription-form">
	<form
		action={formUrl}
		method="post"
		class="keila-form"
	>
		<div class="form-field email-submit-row">
			<input
				type="email"
				id="contact_email"
				name="contact[email]"
				required
				placeholder="Type your email..."
				class="keila-input"
			/>
			<button type="submit" class="keila-submit">Subscribe</button>
		</div>
		<!-- Honeypot field to prevent spam -->
		<input aria-hidden="true" autocomplete="off" name="h[url]" style="display: none" />
		<div class="keila-message" role="alert" aria-live="polite"></div>
	</form>
</div>

<style>
	.keila-subscription-form {
		max-width: 400px;
		margin: 2rem auto;
	}

	.keila-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-field {
		display: flex;
		flex-direction: column;
	}

	.email-submit-row {
		flex-direction: row;
		gap: 0;
	}

	.email-submit-row .keila-input {
		border-radius: 8px 0 0 8px;
	}

	.email-submit-row .keila-submit {
		border-radius: 0 8px 8px 0;
	}

	.keila-input {
		flex: 1;
		padding: 0.75rem;
		border: 1px solid #6b7280;
		border-radius: 8px;
		font-size: inherit;
		font-family: inherit;
		background: var(--theme-bg, #fff);
		color: var(--theme-text, #000);
	}

	.keila-input:focus {
		outline: none;
	}

	.keila-submit {
		padding: 0.75rem 1.5rem;
		background: #6b7280;
		color: white;
		border: none;
		border-radius: 8px;
		font-size: inherit;
		font-family: inherit;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.keila-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.keila-message {
		padding: 0.75rem;
		border-radius: 8px;
		font-size: inherit;
		display: none;
	}

	.keila-message.show {
		display: block;
	}

	.keila-message.success {
		background: #d4edda;
		color: #155724;
		border: 1px solid #c3e6cb;
	}

	.keila-message.error {
		background: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c6cb;
	}

	.keila-message.error a {
		color: #721c24;
		font-weight: 600;
	}

	.keila-message.loading {
		background: #d1ecf1;
		color: #0c5460;
		border: 1px solid #bee5eb;
	}
</style>

<script>
	function initKeilaForms() {
		const forms = document.querySelectorAll('.keila-form');

		forms.forEach((form) => {
			const formElement = form as HTMLFormElement;
			if (formElement.dataset.keilaInitialized) return;
			formElement.dataset.keilaInitialized = 'true';

			const submitButton = formElement.querySelector('.keila-submit') as HTMLButtonElement;
			const messageDiv = formElement.querySelector('.keila-message') as HTMLDivElement;

			formElement.addEventListener('submit', async (e) => {
				e.preventDefault();

				// Show loading state
				submitButton.disabled = true;
				messageDiv.textContent = 'Subscribing...';
				messageDiv.className = 'keila-message show loading';

				try {
					const response = await fetch(formElement.action, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/x-www-form-urlencoded',
						},
						body: new URLSearchParams(new FormData(formElement) as any),
					});

					if (response.ok) {
						messageDiv.textContent = 'Success! Your email address has been subscribed.';
						messageDiv.className = 'keila-message show success';
						formElement.reset();
					} else {
						throw new Error(`Server responded with ${response.status}`);
					}
				} catch (error) {
					messageDiv.innerHTML = 'Sorry, something went wrong. Please email <a href="mailto:support@andrewmarder.net">support@andrewmarder.net</a> to subscribe.';
					messageDiv.className = 'keila-message show error';
				} finally {
					submitButton.disabled = false;
				}
			});
		});
	}

	// Initialize on page load
	initKeilaForms();

	// Re-initialize after navigation in SPA-style apps
	document.addEventListener('astro:page-load', initKeilaForms);
</script>
