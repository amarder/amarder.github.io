---
interface Props {
	listmonkUrl: string;
	listId: string;
	listName?: string;
	showNameField?: boolean;
	showListCheckbox?: boolean;
}

const { listmonkUrl, listId, listName, showNameField = true, showListCheckbox = false } = Astro.props;
---

<div class="listmonk-subscription-form">
	<iframe name="listmonk-iframe" style="display: none;"></iframe>
	<form 
		class="listmonk-form" 
		method="post"
		action={`${listmonkUrl}/subscription/form`}
		target="listmonk-iframe"
		data-listmonk-url={listmonkUrl} 
		data-list-id={listId}
	>
		<input type="hidden" name="nonce" />
		<input type="hidden" name="l" value={listId} />
		<div class="form-field">
			<input
				type="email"
				name="email"
				required
				placeholder="Email address"
				class="listmonk-input"
			/>
		</div>
		{showNameField && (
			<div class="form-field">
				<input
					type="text"
					name="name"
					placeholder="First name (optional)"
					class="listmonk-input"
				/>
			</div>
		)}
		{showListCheckbox && listName && (
			<div class="form-field checkbox-field">
				<input
					type="checkbox"
					name="l"
					id={`list-${listId}`}
					checked
					value={listId}
					class="listmonk-checkbox"
				/>
				<label for={`list-${listId}`}>{listName}</label>
			</div>
		)}
		<button type="submit" class="listmonk-submit">Subscribe</button>
		<div class="listmonk-message" role="alert" aria-live="polite"></div>
	</form>
</div>

<style>
	.listmonk-subscription-form {
		width: 50%;
		max-width: 400px;
		margin: 2rem 0;
	}

	.listmonk-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-field {
		display: flex;
		flex-direction: column;
	}

	.checkbox-field {
		flex-direction: row;
		align-items: center;
		gap: 0.5rem;
	}

	.listmonk-input {
		padding: 0.75rem;
		border: 1px solid var(--theme-divider, #ddd);
		border-radius: 4px;
		font-size: inherit;
		font-family: inherit;
		background: var(--theme-bg, #fff);
		color: var(--theme-text, #000);
	}

	.listmonk-input:focus {
		outline: 2px solid var(--theme-accent, #0066cc);
		outline-offset: 2px;
	}

	.listmonk-checkbox {
		width: 1.25rem;
		height: 1.25rem;
		cursor: pointer;
	}

	.checkbox-field label {
		cursor: pointer;
		margin: 0;
		font-size: inherit;
	}

	.listmonk-submit {
		padding: 0.75rem 1.5rem;
		background: var(--theme-accent, #0066cc);
		color: white;
		border: none;
		border-radius: 4px;
		font-size: inherit;
		font-family: inherit;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s;
	}

	.listmonk-submit:hover {
		background: var(--theme-accent-hover, #0052a3);
	}

	.listmonk-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.listmonk-message {
		padding: 0.75rem;
		border-radius: 4px;
		font-size: inherit;
		display: none;
	}

	.listmonk-message.show {
		display: block;
	}

	.listmonk-message.success {
		background: #d4edda;
		color: #155724;
		border: 1px solid #c3e6cb;
	}

	.listmonk-message.error {
		background: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c6cb;
	}

	.listmonk-message.loading {
		background: #d1ecf1;
		color: #0c5460;
		border: 1px solid #bee5eb;
	}
</style>

<script>
	function initListmonkForms() {
		const forms = document.querySelectorAll('.listmonk-form');
		
		forms.forEach((form) => {
			if (form.dataset.listmonkInitialized) return;
			form.dataset.listmonkInitialized = 'true';

			const formElement = form as HTMLFormElement;
			const submitButton = formElement.querySelector('.listmonk-submit') as HTMLButtonElement;
			const messageDiv = formElement.querySelector('.listmonk-message') as HTMLDivElement;
			
			formElement.addEventListener('submit', (e) => {
				// Don't prevent default - let it submit to iframe
				// Show loading state
				submitButton.disabled = true;
				messageDiv.textContent = 'Subscribing...';
				messageDiv.className = 'listmonk-message show loading';
				
				// Since we can't read the iframe response due to CORS,
				// we'll show a success message after a short delay
				setTimeout(() => {
					messageDiv.textContent = 'Success! Please check your email to confirm your subscription.';
					messageDiv.className = 'listmonk-message show success';
					formElement.reset();
					submitButton.disabled = false;
				}, 1500);
			});
		});
	}

	// Initialize on page load
	initListmonkForms();

	// Re-initialize after navigation in SPA-style apps
	document.addEventListener('astro:page-load', initListmonkForms);
</script>
