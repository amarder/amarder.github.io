---
import { listmonkConfig } from "@/site.config";

interface Props {
	listmonkUrl?: string;
	listId?: string;
}

const { 
	listmonkUrl = listmonkConfig.url, 
	listId = listmonkConfig.listId, 
} = Astro.props;
---

<div class="listmonk-subscription-form">
	<form 
		class="listmonk-form" 
		data-listmonk-url={listmonkUrl} 
		data-list-id={listId}
	>
		<div class="form-field email-submit-row">
			<input
				type="email"
				name="email"
				required
				placeholder="Type your email..."
				class="listmonk-input"
			/>
			<button type="submit" class="listmonk-submit">Subscribe</button>
		</div>
		<div class="listmonk-message" role="alert" aria-live="polite"></div>
	</form>
</div>

<style>
	.listmonk-subscription-form {
		max-width: 400px;
		margin: 2rem auto;
	}

	.listmonk-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-field {
		display: flex;
		flex-direction: column;
	}

	.email-submit-row {
		flex-direction: row;
		gap: 0;
	}

	.email-submit-row .listmonk-input {
		border-radius: 8px 0 0 8px;
	}

	.email-submit-row .listmonk-submit {
		border-radius: 0 8px 8px 0;
	}

	.listmonk-input {
		flex: 1;
		padding: 0.75rem;
		border: 1px solid #6b7280;
		border-radius: 8px;
		font-size: inherit;
		font-family: inherit;
		background: var(--theme-bg, #fff);
		color: var(--theme-text, #000);
	}

	.listmonk-input:focus {
		outline: none;
	}

	.listmonk-submit {
		padding: 0.75rem 1.5rem;
		background: #6b7280;
		color: white;
		border: none;
		border-radius: 8px;
		font-size: inherit;
		font-family: inherit;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.listmonk-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.listmonk-message {
		padding: 0.75rem;
		border-radius: 8px;
		font-size: inherit;
		display: none;
	}

	.listmonk-message.show {
		display: block;
	}

	.listmonk-message.success {
		background: #d4edda;
		color: #155724;
		border: 1px solid #c3e6cb;
	}

	.listmonk-message.error {
		background: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c6cb;
	}

	.listmonk-message.error a {
		color: #721c24;
		font-weight: 600;
	}

	.listmonk-message.loading {
		background: #d1ecf1;
		color: #0c5460;
		border: 1px solid #bee5eb;
	}
</style>

<script>
	function initListmonkForms() {
		const forms = document.querySelectorAll('.listmonk-form');
		
		forms.forEach((form) => {
			const formElement = form as HTMLFormElement;
			if (formElement.dataset.listmonkInitialized) return;
			formElement.dataset.listmonkInitialized = 'true';

			const submitButton = formElement.querySelector('.listmonk-submit') as HTMLButtonElement;
			const messageDiv = formElement.querySelector('.listmonk-message') as HTMLDivElement;
			const emailInput = formElement.querySelector('.listmonk-input') as HTMLInputElement;
			const listmonkUrl = formElement.dataset.listmonkUrl;
			const listId = formElement.dataset.listId;
			
			formElement.addEventListener('submit', async (e) => {
				e.preventDefault();
				
				// Show loading state
				submitButton.disabled = true;
				messageDiv.textContent = 'Subscribing...';
				messageDiv.className = 'listmonk-message show loading';
				
				try {
					const response = await fetch(`${listmonkUrl}/subscription/form`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/x-www-form-urlencoded',
						},
						body: new URLSearchParams({
							email: emailInput.value,
							l: listId || '',
							nonce: '',
						}),
					});

					if (response.ok) {
						messageDiv.textContent = 'Success! Your email address has been subscribed.';
						messageDiv.className = 'listmonk-message show success';
						formElement.reset();
					} else {
						throw new Error(`Server responded with ${response.status}`);
					}
				} catch (error) {
					messageDiv.innerHTML = 'Sorry, something went wrong. Please email <a href="mailto:support@andrewmarder.net">support@andrewmarder.net</a> to subscribe.';
					messageDiv.className = 'listmonk-message show error';
				} finally {
					submitButton.disabled = false;
				}
			});
		});
	}

	// Initialize on page load
	initListmonkForms();

	// Re-initialize after navigation in SPA-style apps
	document.addEventListener('astro:page-load', initListmonkForms);
</script>
