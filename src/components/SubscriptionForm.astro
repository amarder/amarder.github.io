---
import { surveySubscription } from "@/site.config";
---

<div class="mt-12 border-t border-gray-200 dark:border-gray-700"></div>
<div class="mx-auto max-w-md pt-12 text-center ec-theme-root">
	<p class="text-lg font-semibold text-accent-2">Email Updates</p>
	<p class="mt-1 mb-4 text-sm">
		Get a weekly summary of my new posts on data, code, and self-hosting. No spam, unsubscribe
		anytime.
	</p>
	<form id="subscription-form" class="ec-surface flex items-stretch overflow-hidden p-1">
		<label for="subscription-email" class="sr-only">Email address</label>
		<input
			type="email"
			id="subscription-email"
			name="email"
			required
			autocomplete="email"
			placeholder="Your email address"
			class="min-w-0 flex-1 border-0 bg-transparent px-3 py-2 text-sm text-global-text placeholder:text-gray-400 focus:outline-none dark:placeholder:text-gray-500"
		/>
		<button
			type="submit"
			id="subscription-submit"
			class="shrink-0 cursor-pointer rounded-sm bg-gray-500 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-600 disabled:cursor-not-allowed disabled:opacity-60"
		>
			Subscribe
		</button>
	</form>
	<div id="subscription-status" class="ec-panel mt-6 hidden text-left text-sm" hidden></div>
</div>

<script is:inline define:vars={{ surveySubscription }}>
	const form = document.getElementById("subscription-form");
	const emailInput = document.getElementById("subscription-email");
	const submitButton = document.getElementById("subscription-submit");
	const status = document.getElementById("subscription-status");

	const successMessage = "Thanks for signing up! I'll be in touch.";
	const errorMessage =
		'Something went wrong. Please email me at <a href="mailto:subscribe@andrewmarder.net" class="underline">subscribe@andrewmarder.net</a> and I\'ll add you to the newsletter.';

	function showStatus(message, isHtml = false) {
		if (!status) return;
		if (isHtml) {
			status.innerHTML = message;
		} else {
			status.textContent = message;
		}
		status.hidden = false;
		status.classList.remove("hidden");
		status.scrollIntoView({ behavior: "smooth", block: "nearest" });
	}

	if (
		form instanceof HTMLFormElement &&
		emailInput instanceof HTMLInputElement &&
		submitButton instanceof HTMLButtonElement &&
		status instanceof HTMLElement
	) {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			const umami = window.umami;
			if (umami && typeof umami.track === "function") {
				umami.track("Subscribe");
			}

			const email = emailInput.value.trim();
			const originalLabel = submitButton.textContent;

			submitButton.disabled = true;
			submitButton.textContent = "Subscribing…";

			let succeeded = false;

			try {
				const response = await fetch(surveySubscription.responseUrl, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						data: { [surveySubscription.emailFieldId]: email },
						finished: true,
						surveyId: surveySubscription.surveyId,
					}),
				});
				succeeded = response.ok;
			} catch {
				succeeded = false;
			}

			if (succeeded) {
				submitButton.textContent = "Success!";
				showStatus(successMessage);
			} else {
				showStatus(errorMessage, true);
				submitButton.disabled = false;
				submitButton.textContent = originalLabel;
			}
		});
	}
</script>
