---
export interface Props {
	/** Amazon product ID (ASIN) */
	productId: string;
	/** Product title */
	title: string;
	/** Path to product image */
	imagePath: string;
	/** Product description */
	description: string;
	/** Product price (optional) */
	price?: string;
	/** Amazon affiliate tag (defaults to andrewmarder-20) */
	affiliateTag?: string;
}

const { 
	productId, 
	title, 
	imagePath, 
	description, 
	price,
	affiliateTag = "andrewmarder-20" 
} = Astro.props;

const amazonUrl = `https://www.amazon.com/dp/${productId}?tag=${affiliateTag}`;
---

<div class="amazon-product-card group relative overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg dark:border-gray-700 dark:bg-gray-800 p-4 mb-1">
	<div class="aspect-square overflow-hidden rounded-md mb-4">
		<img 
			src={imagePath} 
			alt={title}
			class="h-full w-full object-cover object-top mt-0"
			loading="lazy"
		/>
	</div>
	
	<div class="space-y-3">
		<a 
			href={amazonUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex w-full items-center justify-center rounded-md bg-orange-500 px-4 py-2 text-sm font-medium text-white transition-colors duration-200 hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800"
		>
		<span class="sr-only">amazon</span>
			{price} on Amazon
		</a>
	<p class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">
		{title}
	</p>
		<p class="text-sm text-gray-600 dark:text-gray-400">
			{description}
		</p>
	</div>
</div>

<style>
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style> 