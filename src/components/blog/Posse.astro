---
interface Props {
	/** Optional array of markdown-style links, e.g. "[Reddit](https://...)" */
	links?: string[];
}

const { links = [] } = Astro.props;

const parsed = links
	.map((s) => {
		const m = s.match(/^\[([^\]]*)\]\((https?:\/\/[^)]*)\)$/);
		return m ? { label: m[1], href: m[2] } : null;
	})
	.filter((x): x is { label: string; href: string } => x !== null);
---

{parsed.length > 0 && (
	<aside class="mt-12 -mb-6 border-t border-gray-200 pt-6 dark:border-gray-700" aria-label="Discussion elsewhere">
		<p class="text-sm text-gray-600 dark:text-gray-400">
			Discussed on:{" "}
			{parsed.map(({ label, href }, i) => (
				<>
					{i > 0 && ", "}
					<a href={href} class="text-accent hover:underline" rel="noopener noreferrer" target="_blank">
						{label}
					</a>
				</>
			))}
		</p>
	</aside>
)}
